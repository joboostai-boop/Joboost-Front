# Port d'écoute (Render fournit PORT automatiquement)
PORT=4100

# Secret partagé avec le backend principal. Si défini, chaque requête /extract
# doit présenter l'en-tête `x-scraper-key` correspondant (recommandé en prod).
SCRAPER_SECRET=

# Chemin d'un Chromium pré-installé (sinon Puppeteer télécharge le sien au build).
# Sur Render, laisser vide : Puppeteer installe Chromium via `postinstall`.
# PUPPETEER_EXECUTABLE_PATH=
