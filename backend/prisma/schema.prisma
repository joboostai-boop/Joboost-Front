datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URI")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  ADVISOR
  ADMIN
  BUSINESS_PARTNER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  users     User[]
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String?  // Optionnel si on se connecte via OAuth ou magic link
  name              String
  title             String?
  photoUrl          String?  // Photo de profil (importée via LinkedIn ou Google OAuth)
  role              Role     @default(CANDIDATE)
  
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  
  // France Travail Tokens
  ftAccessToken     String?
  ftRefreshToken    String?
  ftTokenExpiresAt  DateTime?
  summary           String?
  skills            String[]
  languages         String[]
  hobbies           String[]
  linkedin          String?
  portfolio         String?
  github            String?
  plan              String   @default("Gratuit")
  applicationsCount Int      @default(0)
  quota             Int      @default(100)
  credits           Int      @default(0) // solde de candidatures achetées via packs (n'expire pas avec le mois)
  monthlyUsage      Int      @default(0) // candidatures IA consommées sur le mois en cours
  usageMonth        String?  // "YYYY-MM" du mois en cours ; sert au reset mensuel du quota
  phone             String?
  city              String?
  postalCode        String?

  // Profil étendu (CV complet)
  firstName         String?
  lastName          String?
  targetSectors     String[]  @default([])
  targetLocations   String[]  @default([])
  contractTypes     String[]  @default([])
  workTime          String?
  availability      String?
  salaryMin         Int?
  salaryMax         Int?
  softSkills        String[]  @default([])
  languagesDetailed Json?     @default("[]")
  mobility          String[]  @default([])
  drivingLicenses   String[]  @default([])
  ownVehicle        Boolean?
  workSchedules     String[]  @default([])
  projects          Json?     @default("[]")

  // Réinitialisation de mot de passe (token hashé + expiration)
  resetTokenHash    String?   // SHA-256 du token envoyé par email (jamais stocké en clair)
  resetTokenExpiry  DateTime? // expiration du lien de réinitialisation (1h)

  // Consentements (RGPD / preuve d'acceptation)
  acceptedTermsAt   DateTime? // date d'acceptation des CGU + politique de confidentialité
  marketingOptIn    Boolean   @default(false) // consentement e-mails marketing (opt-in)

  // Alertes emploi par email (opt-in) — voir jobs/jobAlerts.job.ts
  jobAlertOptIn      Boolean   @default(false) // l'utilisateur veut recevoir des offres par email
  jobAlertFrequency  String?   // 'daily' | 'weekly'
  jobAlertLastSentAt DateTime? // dernier passage traité (sert à respecter la fréquence)
  jobAlertSeenIds    String[]  @default([]) // ids d'offres déjà envoyées (évite les doublons d'une alerte à l'autre)
  
  // Utilisation de JSON pour des arrays d'objets complexes (facilite la flexibilité noSQL dans un modèle relationnel)
  experiences       Json?    @default("[]")
  education         Json?    @default("[]")

  // Stripe Billing
  stripeCustomerId    String?   @unique
  stripeSubscriptionId String?  @unique
  subscriptionStatus  String?   // 'active' | 'canceled' | 'past_due' | 'trialing'
  subscriptionEndsAt  DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Candidatures spontanées — automatisation (opt-in explicite requis pour l'envoi auto)
  autoSentThisMonth   Int      @default(0) // compteur d'envois automatiques sur le mois courant
  autoSentMonth       String?  // "YYYY-MM" — sert au reset mensuel du compteur auto
  autoSendEnabled     Boolean  @default(false) // l'utilisateur a explicitement activé l'envoi automatique

  applications      Application[]
  cvs               CV[]
  coverLetters      CoverLetter[]
  savedOpportunities SavedOpportunity[]
  spontaneousApplications SpontaneousApplication[]
  companyBlacklist  CompanyBlacklist[]

  // Business Partner relations
  businessOffers          BusinessOffer[]
  businessAffiliationsOwned BusinessAffiliation[] @relation("BusinessOwner")
  businessAffiliationsAsJobseeker BusinessAffiliation[] @relation("AffiliatedJobseeker")

  // Candidat saisi par un recruteur dans SON vivier (n'est pas un vrai compte Joboost).
  // Permet une suppression propre et d'autoriser l'édition de sa fiche par ce recruteur uniquement.
  managedByBusinessId String?

  @@index([role])
  @@index([organizationId])
  @@index([managedByBusinessId])
}

enum ApplicationStatus {
  PENDING
  SENT
  INTERVIEW
  OFFER
  REJECTED
}

model Application {
  id        String            @id @default(uuid())
  company   String
  title     String
  source    String            @default("Candidature spontanée")
  status    ApplicationStatus @default(PENDING)
  notes     String?

  // Différenciation candidature spontanée vs candidature sur offre
  isSpontaneous Boolean        @default(false)
  spontaneous   SpontaneousApplication?

  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([appliedAt])
  @@index([isSpontaneous])
}

// ==================== CANDIDATURES SPONTANÉES ====================

enum SpontaneousStatus {
  DRAFT          // entreprise identifiée, rien de préparé
  READY          // lettre + pièces jointes prêtes, non envoyé
  PENDING_REVIEW // JobBoost attend la validation de l'utilisateur (AUTO_REVIEW)
  SENDING        // envoi en cours (job async)
  SENT           // email envoyé avec succès
  BOUNCED        // adresse invalide / bounce
  REPLIED        // l'entreprise a répondu
  FOLLOWED_UP    // relance envoyée
  ARCHIVED       // écarté / ignoré
}

enum AutoLevel {
  AUTO_SAFE   // envoi immédiat sans validation
  AUTO_REVIEW // envoi après validation utilisateur
  NO_SEND     // jamais automatique, action manuelle uniquement
}

model SpontaneousApplication {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Entreprise ciblée
  companyName     String
  companyAddress  String?
  companySector   String?
  companySize     String?
  companyDomain   String?  // ex: "monentreprise.fr" (estimé ou enrichi)
  contactEmail    String?  // email trouvé / estimé / saisi manuellement
  contactName     String?
  contactRole     String?
  contactSource   String?  // "ft_contact" | "estimated" | "manual" | "hunter"

  // Métier / offre source
  jobTitle        String
  ftOfferId       String?
  ftOfferUrl      String?
  ftSource        String?  // "francetravail" | "demo"
  reason          String?  // raison de pertinence (texte)
  hiringPotential String?

  // Lettre de motivation
  coverLetterId   String?
  coverLetter     CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  coverLetterText String?  // snapshot du texte au moment de l'envoi

  // Automatisation
  autoLevel       AutoLevel @default(AUTO_REVIEW)
  autoScore       Int       @default(0) // 0-100
  autoBlockReason String?   // raison si NO_SEND

  // Statut / suivi
  status          SpontaneousStatus @default(DRAFT)
  applicationId   String?           @unique
  application     Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // Tracking email
  sentAt          DateTime?
  messageId       String?  // Message-ID SMTP pour rapprocher les réponses
  openedAt        DateTime?
  bouncedAt       DateTime?
  repliedAt       DateTime?

  // Relances
  followUpAt      DateTime? // prochaine relance planifiée
  followUpCount   Int       @default(0)
  lastFollowUpAt  DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, autoLevel])
  @@index([status])
  @@index([followUpAt])
  @@index([companyDomain])
}

model CompanyBlacklist {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  domain      String?
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([userId, companyName])
  @@index([userId])
  @@index([userId, domain])
}

model CV {
  id        String   @id @default(uuid())
  title     String   @default("Mon CV") 
  content   Json     // Contenu figé ou base du CV (JSON)
  template  String   @default("Moderne")
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CoverLetter {
  id        String   @id @default(uuid())
  title     String   @default("Ma Lettre")
  company   String?
  jobTitle  String?
  content   String   // Texte de la lettre
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spontaneousApplications SpontaneousApplication[]

  @@index([userId])
}

model SavedOpportunity {
  id          String   @id @default(uuid())
  title       String
  company     String
  location    String?
  salary      String?
  type        String?
  matchScore  Int?
  postedDate  String?
  source      String   @default("Externe")
  url         String?
  tags        String[]
  aiInsight   String?
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ==================== BUSINESS SESSION ====================

model BusinessOffer {
  id             String    @id @default(uuid())
  businessId     String
  business       User      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  title          String
  description    String
  contractType   String?   // CDI, CDD, Stage, Alternance, Mission
  location       String?
  salaryRange    String?
  requiredSkills String[]
  
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  expiresAt      DateTime?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessId])
  @@index([isPublished])
  @@index([businessId, isPublished])
  @@index([createdAt])
}

model BusinessAffiliation {
  id           String   @id @default(uuid())
  businessId   String
  business     User     @relation("BusinessOwner", fields: [businessId], references: [id], onDelete: Cascade)
  
  jobseekerId  String
  jobseeker    User     @relation("AffiliatedJobseeker", fields: [jobseekerId], references: [id], onDelete: Cascade)
  
  affiliatedAt DateTime @default(now())
  status       String   @default("active") // active, inactive, suspended
  note         String?  // note privée du recruteur sur ce candidat (mini-CRM)

  @@unique([businessId, jobseekerId])

  @@index([businessId])
  @@index([businessId, status])
  @@index([jobseekerId])
  @@index([affiliatedAt])
}
