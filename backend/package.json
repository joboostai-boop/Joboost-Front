{
  "name": "joboost-backend",
  "version": "1.0.0",
  "description": "Backend API for JobBoost",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "prisma generate && prisma db push --skip-generate && tsc",
    "test": "ts-node --transpile-only src/services/__tests__/spontaneous.scoring.test.ts",
    "job:followup": "ts-node --transpile-only src/jobs/followup.job.ts",
    "job:alerts": "ts-node --transpile-only src/jobs/jobAlerts.job.ts",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.0",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.11",
    "@types/pdfkit": "^0.17.6",
    "nodemon": "^3.1.0",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
